# Get your free API key from https://aistudio.google.com/apikey
# Free tier: 1,500 requests/day, 15 requests/minute (Gemini 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Supabase — the shared backend the RecruitOps portal writes requisitions to
# and this site reads the /jobs board from.
#
# Both values are NEXT_PUBLIC_ on purpose: the anon key is a public identifier
# that ships in the browser bundle, and what it can reach is defined entirely by
# the row-level security policies on the database (see the portal's
# supabase/migrations/00024_public_job_board_anon_read.sql — anon may read only
# Active/Open requisitions, and only the columns the job board renders).
#
# Never put the service_role key here. It bypasses RLS.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Production Canonical Site URLs
NEXT_PUBLIC_SITE_URL=https://n2psystems.com
NEXT_PUBLIC_APP_URL=https://n2psystems.com

